# Force this project to use the public npm registry, overriding any
# corporate registry configured globally (e.g. Unipol Nexus). The
# corporate registry is fine for work projects but doesn't mirror the
# pnpm/typescript/rxjs/zod packages we depend on here, and times out
# when off-VPN.
#
# This file applies ONLY to this directory tree. Global config
# (~/.npmrc) is untouched.
registry=https://registry.npmjs.org/

# Disable strict-ssl just in case the corporate proxy intercepts. Most
# of the time you don't need this; uncomment if you still get cert
# errors after the registry change.
# strict-ssl=false

# Use a project-local pnpm store so pnpm doesn't try to share state with
# the corporate node setup. Adds ~50MB to the project folder but
# eliminates a class of "permissions" errors on Windows enterprise
# machines.
# store-dir=.pnpm-store
